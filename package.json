{
  "name": "tradelab-test-2",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "tnved-service"
  ],
  "scripts": {
    "dev": "concurrently -n \"NEXT,BACK,TNVED\" -c \"cyan,yellow,magenta\" \"npm:dev:frontend\" \"npm:dev:backend\" \"npm:dev:tnved\"",
    "dev:frontend": "next dev",
    "dev:backend": "npm run dev --prefix backend",
    "dev:tnved": "npm run dev --prefix tnved-service",
    "build": "npm run build:frontend && npm run build:backend && npm run build:tnved",
    "build:frontend": "next build",
    "build:backend": "npm run build --prefix backend",
    "build:tnved": "npm run build --prefix tnved-service",
    "build:tnved:db": "npm run build:db --prefix tnved-service",
    "start": "concurrently -n \"NEXT,BACK,TNVED\" -c \"cyan,yellow,magenta\" \"npm:start:frontend\" \"npm:start:backend\" \"npm:start:tnved\"",
    "start:frontend": "next start",
    "start:backend": "npm run start --prefix backend",
    "start:tnved": "npm run start --prefix tnved-service",
    "lint": "eslint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/nextjs": "^10.34.0",
    "@supabase/supabase-js": "^2.90.1",
    "@svg-maps/china": "^1.0.1",
    "@tanstack/react-query": "^5.90.17",
    "lucide-react": "^0.562.0",
    "next": "16.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
