NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com,admin2@example.com

# Supabase Service Role Key (for server-side API routes only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Sentry Configuration (Optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

#OpenAI Parameters
OPENAI_API_KEY=sk-proj-...
P3_BASE_MODEL  = "gpt-5-mini"
P3_SEARCH_MODEL  = "gpt-5-mini"

# Local Backend Configuration (for development, to avoid 60s timeout)
NEXT_PUBLIC_LOCAL_BACKEND_URL=http://localhost:3001
BACKEND_PORT=3001
DEBUG_ENV=false

# Optional
VERCEL_TOKEN

# TNVED Service
TNVED_PORT=3002
DB_PATH=./data/tnved.db
LOG_LEVEL=info
ENABLE_CACHE=true
CACHE_MAX_SIZE=500
CACHE_TTL_MS=600000
ENABLE_AI_FALLBACK=true
AI_FALLBACK_MIN_RESULTS=3
AI_FALLBACK_MAX_BEST_SCORE=-5
SQLITE_MMAP_SIZE=2147483648